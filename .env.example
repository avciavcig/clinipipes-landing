# Clinipipes Landing — environment variables

PORT=8080
NODE_ENV=development

# ── Canlı (şimdilik sadece landing) ──
# Railway / production:
#   NODE_ENV=production
#   ADMIN_KEY=<güçlü şifre — admin girişi için>
#   GITHUB_TOKEN=<opsiyonel — admin'den içerik deploy>
#
# Portal ve iyzico entegrasyonu TANIMLAMAYIN — sözleşme tamamlanana kadar kapalı kalır.
# ENABLE_PORTAL_INTEGRATION, CLINIPIPES_WEBHOOK_SECRET, CLINIC_PORTAL_URL boş bırakın.

# Admin panel (use strong password in production)
ADMIN_KEY=

# E-posta ile 2FA — Railway Hobby'de Gmail SMTP ÇALIŞMAZ, Resend kullanın:
# 1) https://resend.com → avcivcig@gmail.com ile ücretsiz hesap
# 2) API Keys → Create API Key
# ADMIN_2FA_EMAIL=avcivcig@gmail.com
# RESEND_API_KEY=re_...
# (İlk kurulumda RESEND_FROM boş bırakılabilir — onboarding@resend.dev kullanılır)
#
# SMTP sadece Railway Pro veya local için:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=avcivcig@gmail.com
# SMTP_PASS=<Gmail uygulama şifresi>

# GitHub content deploy (optional)
GITHUB_TOKEN=

# Demo screenshot capture — set on BOTH clinipipes-landing AND clinic-portal Railway services
# 1) Generate shared secret: openssl rand -hex 32
# 2) Portal: demo clinic owner login + form token from /form-settings
# 3) Landing: portal URL + same secret (+ same DEMO_* for direct fallback)
#
# CLINIPIPES_WEBHOOK_SECRET=<same 64-char hex on both services>
# CLINIC_PORTAL_URL=https://app.clinipipes.com
# PORTAL_URL=https://app.clinipipes.com
# DEMO_USER=owner@your-clinic.com
# DEMO_PASS=<owner password>
# DEMO_FORM_PATH=/form/your-clinic-form-token
# DEMO_DOCTOR_USER=doctor@your-clinic.com
# DEMO_DOCTOR_PASS=<optional — defaults to DEMO_PASS>
#
# Verify: npm run check:demo-env
# Capture: npm run capture:demo  (admin → Demo → Canlı Panelden Görüntü Al)

# Her iki serviste de aynı secret kullanılmalı.
# Generate: openssl rand -hex 32
# ENABLE_PORTAL_INTEGRATION=true
# CLINIPIPES_WEBHOOK_SECRET=
# CLINIC_PORTAL_URL=https://app.clinipipes.com
