# Clinipipes Landing — environment variables

PORT=8080
NODE_ENV=development

# ── Canlı (landing + portal entegrasyonu) ──
# Railway / production:
#   NODE_ENV=production
#   ADMIN_KEY=<güçlü şifre — admin girişi için>
#   GITHUB_TOKEN=<opsiyonel — admin'den içerik deploy>
#
# Otomatik provisioning için (her iki serviste aynı secret):
#   ENABLE_PORTAL_INTEGRATION=true
#   CLINIPIPES_WEBHOOK_SECRET=<openssl rand -hex 32>
#   CLINIC_PORTAL_URL=https://clinic-portal-production-3068.up.railway.app
#
# Manuel mod (sözleşme / iyzico hazır olana kadar): entegrasyon değişkenlerini boş bırakın.

# Admin panel (use strong password in production)
ADMIN_KEY=

# E-posta ile 2FA — Railway Hobby'de Gmail SMTP ÇALIŞMAZ, Resend kullanın:
# 1) https://resend.com → API Keys → Create API Key
# ADMIN_2FA_EMAIL=you@example.com
# RESEND_API_KEY=re_...
#
# Portal tarafında (klinik bildirim / test e-postası): aynı RESEND veya SMTP_USER+SMTP_PASS
# Portal env: PRO_PLAN_PRICE=79, PRO_PLAN_LIST_PRICE=119 (landing fiyatlarıyla senkron)

# GitHub content deploy (optional)
GITHUB_TOKEN=

# Demo screenshot capture — set on BOTH clinipipes-landing AND clinic-portal Railway services
# CLINIPIPES_WEBHOOK_SECRET=<same 64-char hex on both services>
# CLINIC_PORTAL_URL=https://clinic-portal-production-3068.up.railway.app
# PORTAL_URL=https://clinic-portal-production-3068.up.railway.app
# DEMO_USER=owner@your-clinic.com
# DEMO_PASS=<owner password>
# DEMO_FORM_PATH=/form/your-clinic-form-token
#
# Verify: npm run check:demo-env
# Capture: npm run capture:demo  (admin → Demo → Canlı Panelden Görüntü Al)

# Fiyat senkron özeti (lib/platform-sync.js ile aynı):
# Starter $45 tanıtım / $69 liste · Pro $79 / $119 · Kurulum $99 / $149
