# Clinipipes Landing — environment variables

PORT=8080
NODE_ENV=development

# ── Canlı (şimdilik sadece landing) ──
# Railway / production:
#   NODE_ENV=production
#   ADMIN_KEY=<güçlü şifre — admin girişi için>
#   GITHUB_TOKEN=<opsiyonel — admin'den içerik deploy>
#
# Portal ve iyzico entegrasyonu TANIMLAMAYIN — sözleşme tamamlanana kadar kapalı kalır.
# ENABLE_PORTAL_INTEGRATION, CLINIPIPES_WEBHOOK_SECRET, CLINIC_PORTAL_URL boş bırakın.

# Admin panel (use strong password in production)
ADMIN_KEY=

# 2FA kalıcılığı — kurulumdan sonra bu anahtarı Railway'e ekleyin (Google Authenticator kurulum anahtarı)
# ADMIN_TOTP_SECRET=

# GitHub content deploy (optional)
GITHUB_TOKEN=

# Demo screenshot capture (optional — admin panel or npm run capture:demo)
# PORTAL_URL=https://clinic-portal-production-3068.up.railway.app
# DEMO_USER=owner
# DEMO_PASS=
# DEMO_DOCTOR_USER=doctor
# DEMO_DOCTOR_PASS=
# DEMO_FORM_PATH=/form/54d115ed98192cda23a85c1f413618fd

# Her iki serviste de aynı secret kullanılmalı.
# Generate: openssl rand -hex 32
# ENABLE_PORTAL_INTEGRATION=true
# CLINIPIPES_WEBHOOK_SECRET=
# CLINIC_PORTAL_URL=https://app.clinipipes.com
